---
import { href } from '../lib/blog';
import { theme } from '../theme';
import '../styles/theme.css';
interface Props { title?: string; description?: string; exhibition?: boolean }
const { title = theme.title, description = theme.description, exhibition = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#f5f5f1"/><link rel="canonical" href={canonical}/><link rel="alternate" type="application/atom+xml" title={theme.title} href={href('atom.xml')}/><title>{title === theme.title ? title : `${title} · ${theme.title}`}</title>
<script is:inline>try{const t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch{}</script></head>
<body id="top" class:list={{exhibition}}><a class="skip-link" href="#main">跳到正文</a><header class="site-header"><a class="brand" href={href()} aria-label="Hemin 的首页"><span class="brand-mark" aria-hidden="true">h.</span><span>Hemin<span class="brand-sub">A PERSONAL JOURNAL</span></span></a><nav aria-label="主导航">{theme.navigation.map(({path,label}) => <a class:list={{active:Astro.url.pathname===href(path)}} aria-current={Astro.url.pathname===href(path)?'page':undefined} href={href(path)}>{label}</a>)}</nav><button id="theme" class="theme-toggle" aria-label="切换深浅色模式" title="切换深浅色模式">◐</button></header><main id="main"><slot /></main><footer class="site-footer"><div><a class="footer-title" href={href()}>Hemin</a><p>保持好奇，慢慢生长。</p></div><div class="footer-links"><a href={href('archives.html')}>全部归档</a><a href={href('links.html')}>友情链接</a><a href="https://github.com/HeminWon">GitHub ↗</a><a href={href('atom.xml')}>RSS ↗</a></div><div class="footer-bottom"><span>© 2018–{new Date().getFullYear()} {theme.author}</span><span>{theme.name} · Built with Astro</span><a href="#top">回到顶部 ↑</a></div></footer>
<script>document.querySelector<HTMLButtonElement>('#theme')?.addEventListener('click',()=>{const root=document.documentElement;const dark=root.dataset.theme==='dark'||(!root.dataset.theme&&matchMedia('(prefers-color-scheme: dark)').matches);const value=dark?'light':'dark';root.dataset.theme=value;try{localStorage.setItem('theme',value)}catch{}});</script>
</body></html>
